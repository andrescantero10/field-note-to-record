# Copy to .env and fill in only what you need. Never commit .env.
# The defaults below run everything offline: fake model, mock Zoho.

# --- Storage ---
DATABASE_PATH=./fieldnote.db

# --- Model adapter ---
# "fake" needs no key and is what the tests use.
LLM_PROVIDER=fake
LLM_MODEL=
LLM_API_KEY=

# --- Zoho CRM adapter ---
# "mock" (default) needs no Zoho account. "live" targets a Zoho CRM Developer Edition org.
ZOHO_MODE=mock
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# US data center shown; change both if your org is in another region.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
